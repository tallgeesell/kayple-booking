[Unit]
Description=Consultation booking API (Spring Boot)
After=network.target mysql.service

[Service]
User=ubuntu
WorkingDirectory=/opt/booking
# DB_PASSWORD, ADMIN_PASSWORD 는 서버에만 있는 이 파일에서 주입한다 (깃에 없음)
EnvironmentFile=/etc/booking/booking.env
ExecStart=/usr/bin/java -Xms256m -Xmx512m -Duser.timezone=Asia/Seoul -jar /opt/booking/app.jar
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
